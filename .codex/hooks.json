{
  "description": "Decision-Driven Agent project lifecycle hooks using the repository decision layer and JEV configuration.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -u \"$(git rev-parse --show-toplevel)/.codex/hooks/decision_agent_hook.py\"",
            "commandWindows": "for /f \"delims=\" %i in ('git rev-parse --show-toplevel') do @python -u \"%i\\.codex\\hooks\\decision_agent_hook.py\"",
            "timeout": 10,
            "statusMessage": "Recording task requirement"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python -u \"$(git rev-parse --show-toplevel)/.codex/hooks/decision_agent_hook.py\"",
            "commandWindows": "for /f \"delims=\" %i in ('git rev-parse --show-toplevel') do @python -u \"%i\\.codex\\hooks\\decision_agent_hook.py\"",
            "timeout": 15,
            "statusMessage": "Checking tool risk"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python -u \"$(git rev-parse --show-toplevel)/.codex/hooks/decision_agent_hook.py\"",
            "commandWindows": "for /f \"delims=\" %i in ('git rev-parse --show-toplevel') do @python -u \"%i\\.codex\\hooks\\decision_agent_hook.py\"",
            "timeout": 15,
            "statusMessage": "Recording execution evidence"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -u \"$(git rev-parse --show-toplevel)/.codex/hooks/decision_agent_hook.py\"",
            "commandWindows": "for /f \"delims=\" %i in ('git rev-parse --show-toplevel') do @python -u \"%i\\.codex\\hooks\\decision_agent_hook.py\"",
            "timeout": 45,
            "statusMessage": "Checking completion evidence"
          }
        ]
      }
    ]
  }
}
